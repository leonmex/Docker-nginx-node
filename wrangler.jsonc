{
    // Cloudflare Workers Static Assets deployment for a pre-rendered (output: "static") Astro site.
    // No "main" / Worker script: this is an assets-only Worker that serves the built ./dist directory.
    "name": "nbarrera-personal-web",
    "compatibility_date": "2026-06-29",
    "assets": {
        "directory": "./dist",
        // Multi-page static site: serve ./dist/404.html on unknown paths if it exists,
        // otherwise Cloudflare returns its default 404. (Add src/pages/404.astro to customize.)
        "not_found_handling": "404-page"
    }
}