### NODE / APP ###
APP_ROUTE=./dashboard
HOST_HTTP_PORT=80
NGINX_PORT=80

### POSTGRES ###
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrestest
POSTGRES_DB=test
DATABASE_URL="postgresql://postgres:postgrestest@dbPostgres:5432/test?schema=public"

### REDIS / CACHE ###
REDIS_URL="redis://redis:6379"
USE_CACHE=true
CACHE_PROVIDER=redis

### SERVER / OBSERVABILITY ###
PORT=5000
COOKIE_SECRET=dev-only-change-me-in-production
SERVICE_NAME=node-nginx-clean-server
LOG_LEVEL=debug
# Log destination: stdout (default, for collectors) | file | both
LOG_OUTPUT=both
# Relative to the container's cwd (/usr/src/server) — docker-compose.yml
# bind-mounts this exact path to TELEMETRY_LOG_NAS_DIR below, so logger.ts's
# NAS-mount check (see CLAUDE-IMPLEMENT-OPTOMETRY-DASHBOARD-FOR-THE-SYSTEM.md
# §5.5) validates whatever ends up mounted at logs/ inside the container.
LOG_DIR=logs
LOG_FILE=server.log
# Host path bind-mounted onto LOG_DIR above — must be a real network
# filesystem (see logger.ts's checkNasMount) or startup fails loudly.
TELEMETRY_LOG_NAS_DIR=server-logs-local
# Escape hatch: set to true to allow a plain local LOG_DIR (e.g. no NAS
# access in this dev environment) instead of failing startup.
ALLOW_LOCAL_LOG_DIR=true

# Self-pointing: the `server` service's env_file: directive reads this var
# (via docker-compose.yml's ${SERVER_ENV_FILE:-./.env}) to know which file
# to load INSIDE the container — `docker compose --env-file` alone does NOT
# affect env_file: directives, only ${VAR} interpolation in the YAML itself.
# Without this, `server` would silently load the real .env even in
# presentation mode. See README_RUN_PRESENTATION.md.
SERVER_ENV_FILE=.env.presentation

### JWT / AUTHENTICATION ###
# Change these in production! Used for signing mobile JWT tokens.
JWT_ACCESS_SECRET=dev-only-jwt-access-secret-change-in-production-12345678
JWT_REFRESH_SECRET=dev-only-jwt-refresh-secret-change-in-production-87654321


### PAYMENT / ENCRYPTION ###
# Change this in production! Used for encrypting IBAN/payment data.
# Must be base64 that decodes to EXACTLY 32 bytes for AES-256 (not 32
# characters of plain text — a 32-character string here decodes to a
# different, wrong byte count and every encryptSensitive() call will throw
# "PAYMENT_ENCRYPTION_KEY must decode to 32 bytes..."). Generate a real one
# with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYMENT_ENCRYPTION_KEY=etqYbvZ2iFbXbyEP6HL8tD+pFfSe4+R3uylgw40K5PY=


### MINIO CONFIGURATION
MINIO_PUBLIC_URL_BASE=https://192.168.178.43/media

# MinIO's actual data directory (both buckets: blablarags-apparel product
# images AND telemetry-logs) — NAS-backed, not local disk. See
# CLAUDE-IMPLEMENT-OPTOMETRY-DASHBOARD-FOR-THE-SYSTEM.md §2.6 (updated
# 2026-08-06): MinIO doesn't officially support CIFS/NFS as backing storage
# (no guaranteed atomic rename/flock), accepted as a known risk so this can
# be validated for real before the Kubernetes move, rather than discovered
# for the first time in production.
MINIO_DATA_NAS_DIR=minio-data

### OBSERVABILITY (docker-compose.observability.yml — opt-in, see
### CLAUDE-IMPLEMENT-OPTOMETRY-DASHBOARD-FOR-THE-SYSTEM.md) ###
GRAFANA_ADMIN_PASSWORD=dev-only-change-me

