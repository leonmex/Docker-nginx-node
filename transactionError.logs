dbPostgres  | 	-- Admin dashboard can monitor training job status and view queued items.
dbPostgres  | 	
dbPostgres  | 	CREATE TABLE IF NOT EXISTS ai_training_queue (
dbPostgres  | 	  id                    SERIAL PRIMARY KEY,
dbPostgres  | 	  item_id               INTEGER     NOT NULL REFERENCES product_items(id) ON DELETE CASCADE,
dbPostgres  | 	  group_id              INTEGER     NOT NULL REFERENCES product_groups(id) ON DELETE CASCADE,
dbPostgres  | 	  account_id            INTEGER     NOT NULL REFERENCES mobile_accounts(id) ON DELETE CASCADE,
dbPostgres  | 	
dbPostgres  | 	  -- Image URL at the time of submission (may be on MinIO)
dbPostgres  | 	  image_url             TEXT        NOT NULL,
dbPostgres  | 	
dbPostgres  | 	  -- The AI's original prediction (what we're correcting)
dbPostgres  | 	  original_category     VARCHAR(64),
dbPostgres  | 	  original_confidence   NUMERIC(4, 3),
dbPostgres  | 	
dbPostgres  | 	  -- The correct category (user override or true label)
dbPostgres  | 	  correct_category      VARCHAR(64) NOT NULL,
dbPostgres  | 	
dbPostgres  | 	  -- Training status
dbPostgres  | 	  status                VARCHAR(32) NOT NULL DEFAULT 'pending', -- pending | processing | completed | failed
dbPostgres  | 	  training_job_id       VARCHAR(128),                          -- external job ID from ML pipeline
dbPostgres  | 	  error_message         TEXT,
dbPostgres  | 	
dbPostgres  | 	  -- Admin notes
dbPostgres  | 	  admin_notes           TEXT,
dbPostgres  | 	  submitted_by_user_id INTEGER REFERENCES "user"(id) ON DELETE SET NULL,
dbPostgres  | 	
dbPostgres  | 	  -- Timestamps
dbPostgres  | 	  created_at            TIMESTAMPTZ NOT NULL DEFAULT now(),
dbPostgres  | 	  started_at            TIMESTAMPTZ,
dbPostgres  | 	  completed_at          TIMESTAMPTZ,
dbPostgres  | 	  updated_at            TIMESTAMPTZ NOT NULL DEFAULT now()
dbPostgres  | 	);
dbPostgres  | 	
dbPostgres  | 	-- Indexes for common queries
dbPostgres  | 	CREATE INDEX IF NOT EXISTS idx_ai_training_queue_account
dbPostgres  | 	  ON ai_training_queue (account_id);
dbPostgres  | 	CREATE INDEX IF NOT EXISTS idx_ai_training_queue_item
dbPostgres  | 	  ON ai_training_queue (item_id);
dbPostgres  | 	CREATE INDEX IF NOT EXISTS idx_ai_training_queue_group
dbPostgres  | 	  ON ai_training_queue (group_id);
dbPostgres  | 	CREATE INDEX IF NOT EXISTS idx_ai_training_queue_status
dbPostgres  | 	  ON ai_training_queue (status) WHERE status IN ('pending', 'processing');
dbPostgres  | 	CREATE INDEX IF NOT EXISTS idx_ai_training_queue_created
dbPostgres  | 	  ON ai_training_queue (created_at DESC);
dbPostgres  | 	
