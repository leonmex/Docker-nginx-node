---
import ContactForm from './ContactForm.tsx';
import { useTranslations } from '../i18n/utils';
import profile from '../data/profile.json';

interface Props {
  currentLang: string;
}

const { currentLang } = Astro.props;
const t = useTranslations(currentLang);

// Anti-scraping: encode contact data so raw values never appear in the HTML source
const encodedEmail = btoa(profile.contact.email);
const reversedEmail = profile.contact.email.split('').reverse().join('');
const encodedLinkedin = btoa(profile.contact.linkedin);
const encodedGithub = btoa(profile.contact.github);

const formTranslations = {
  name: t('contact.form.name'),
  email: t('contact.form.email'),
  message: t('contact.form.message'),
  submit: t('contact.form.submit'),
  success: t('contact.form.success'),
  reset: t('contact.form.reset')
};
---

<section id="contact" class="contact-section">
  <div class="container contact-container">
    <div class="contact-main-grid">
      
      <!-- Contact Info -->
      <div>
        <span class="caption-mono contact-eyebrow">
          {t('contact.eyebrow')}
        </span>
        <h2 class="display-lg contact-title-text">{t('contact.title')}</h2>
        <p class="body-md contact-subtitle-text">
          {t('contact.subtitle')}
        </p>

        <!-- Details -->
        <div class="contact-details-list">
          <!-- Email -->
          <div class="contact-details-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" class="contact-icon-svg">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
              <polyline points="22,6 12,13 2,6" />
            </svg>
            <div>
              <span class="caption-mono contact-detail-label">Email</span>
              <a href="#" data-email={encodedEmail} onclick="this.href='mailto:'+atob(this.dataset.email)" class="body-sm-strong contact-detail-link hover-underline">
                <span style="unicode-bidi: bidi-override; direction: rtl;">{reversedEmail}</span>
              </a>
            </div>
          </div>

          <!-- Linkedin -->
          <div class="contact-details-item">
<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="contact-icon-svg">
  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451c.979 0 1.771-.773 1.771-1.729V1.729C24 .774 23.201 0 22.225 0z"/>
</svg>            <div>
              <span class="caption-mono contact-detail-label">Linkedin</span>
              <a href="#" data-href={encodedLinkedin} onclick="(function(el){ window.open(atob(el.dataset.href), '_blank'); })(this)" class="body-sm-strong contact-detail-link hover-underline">
                linkedin.com/in/noelbarrera
              </a>

            </div>
          </div>

          <!-- Address -->
          <div class="contact-details-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" class="contact-icon-svg">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
            <div>
              <span class="caption-mono contact-detail-label">Location</span>
              <span class="body-sm-strong">{profile.contact.address}</span>
            </div>
          </div>

          <!-- GitHub -->
          <div class="contact-details-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" class="contact-icon-svg">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
            </svg>
            <div>
              <span class="caption-mono contact-detail-label">Github</span>
              <a href="#" data-href={encodedGithub} onclick="(function(el){ window.open(atob(el.dataset.href), '_blank'); })(this)" class="body-sm-strong contact-detail-link hover-underline">
                github.com/leonmex
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form Wrapper -->
      <div class="card-marketing contact-form-card-wrapper">
        <ContactForm client:load translations={formTranslations} />
      </div>

    </div>
  </div>
</section>
