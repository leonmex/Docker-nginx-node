---
import profile from '../data/profile.json';
import { useTranslations } from '../i18n/utils';

interface Props {
  currentLang: string;
}

const { currentLang } = Astro.props;
const t = useTranslations(currentLang);
---

<section id="experience" class="experience-section">
  <div class="container experience-container">
    <!-- Section Header -->
    <div class="experience-header">
      <span class="caption-mono experience-eyebrow">
        {t('experience.eyebrow') || "Professional Journey"}
      </span>
      <h2 class="display-lg">{t('experience.title')}</h2>
      <p class="body-lg">{t('experience.subtitle')}</p>
    </div>

    <!-- Timeline Wrapper -->
    <div class="timeline-wrapper">
      <div class="timeline-progress-line"></div>
      {profile.experience.map((job, index) => (
        <div class={`timeline-item animate-on-scroll delay-${(index % 5) + 1}`}>
          <!-- Bullet Point Indicator -->
          <div class="timeline-dot" />
          
          <!-- Period Badge -->
          <div class="timeline-period-container">
            <span class="caption-mono timeline-period-badge">
              {job.period}
            </span>
          </div>

          <!-- Job Details -->
          <h3 class="display-sm timeline-job-role">{job.role}</h3>
          <h4 class="body-md-strong timeline-job-company">
            {job.company}
          </h4>

          <!-- Highlights -->
          <ul class="timeline-highlights-list">
            {job.highlights.map((highlight) => (
              <li class="body-sm timeline-highlight-item">
                <span class="timeline-highlight-dash">—</span>
                {highlight}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function initTimelineProgress() {
    const wrapper = document.querySelector('.timeline-wrapper');
    const progressLine = document.querySelector('.timeline-progress-line') as HTMLElement;
    
    if (!wrapper || !progressLine) return;

    function updateProgress() {
      if (!wrapper || !progressLine) return;
      
      const rect = wrapper.getBoundingClientRect();
      const viewportHeight = window.innerHeight;
      
      // Trigger timeline line animation when the top of the wrapper enters the center/bottom of screen
      const triggerPoint = viewportHeight * 0.7; 
      const totalHeight = rect.height;
      const relativeTop = rect.top;

      let progress = 0;
      if (relativeTop < triggerPoint) {
        const scrolledDistance = triggerPoint - relativeTop;
        progress = (scrolledDistance / totalHeight) * 100;
      }

      const clampedProgress = Math.min(Math.max(progress, 0), 100);
      progressLine.style.height = `${clampedProgress}%`;

      // Highlight timeline dots passed by the progress line
      const items = wrapper.querySelectorAll('.timeline-item');
      items.forEach((item) => {
        const dot = item.querySelector('.timeline-dot');
        if (dot) {
          const dotRect = dot.getBoundingClientRect();
          const dotTopInWrapper = dotRect.top - rect.top + (dotRect.height / 2);
          const progressHeight = (clampedProgress / 100) * totalHeight;

          if (dotTopInWrapper <= progressHeight) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        }
      });
    }

    // Scroll & Resize listeners
    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress, { passive: true });
    
    // Initial calculation
    updateProgress();
  }

  // Bind init function
  initTimelineProgress();
  document.addEventListener('astro:page-load', initTimelineProgress);
</script>
